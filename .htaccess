# Protection du listing des répertoires
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Cert/

    # Laisser passer les fichiers et dossiers existants (assets, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Tout le reste vers le front controller
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
