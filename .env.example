# Copier vers .env à la racine du projet (ne jamais committer .env)

# --- LLM ---
# Option A — Ollama local (recommandé, déjà détecté sur cette machine)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:latest
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_SECONDS=120

# Option B — API cloud OpenAI-compatible (décommenter et renseigner)
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- RAG API ---
RAG_API_URL=http://127.0.0.1:8000
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_TIMEOUT_SECONDS=120

# --- Embeddings / Vector store ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./rag/storage/chroma
CHROMA_COLLECTION=greendc_docs

# --- Chunking ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_OFFICIAL_BOOST=0.05
